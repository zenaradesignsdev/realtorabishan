# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables (Production + Preview).
# Never commit the real values.

# ─── Contact form (required for the form to send) ───────────────────────────

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Abishan's intake inbox — where enquiries land. Required.
CONTACT_TO_EMAIL=

# Verified sender. Must be an address on a domain verified in Resend
# (https://resend.com/domains). If left unset the route falls back to Resend's
# shared onboarding@resend.dev sender, which needs no DNS setup but will ONLY
# deliver to the Resend account owner's own address — fine for a smoke test,
# not for launch.
CONTACT_FROM_EMAIL=

# ─── Site ───────────────────────────────────────────────────────────────────

# Canonical origin, no trailing slash. Drives canonical URLs, OG tags, the
# sitemap and robots.txt. If unset, the site falls back to Vercel's stable
# production domain, then to the theleaseman.ca placeholder — set it explicitly
# once the real domain is confirmed.
NEXT_PUBLIC_SITE_URL=https://theleaseman.ca

# ─── Audit scripts (optional — only for `npm run pagespeed-audit` / `gsc-audit`) ───

# PageSpeed Insights
PSI_URL=https://theleaseman.ca
PSI_API_KEY=
PSI_STRATEGY=both

# Google Search Console (see scripts/GSC_SETUP.md for full setup)
GSC_SITE_URL=https://theleaseman.ca/
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gsc-service-account.json
